# Load this file with: set -a; source .env; set +a
SLACK_BOT_TOKEN='xoxb-replace-me'
SLACK_APP_TOKEN='xapp-replace-me'
LLM_OPENAI_BASE_URL='https://your-gateway.example'
LLM_OPENAI_API_KEY='replace-me'
LLM_MODEL='your-tool-calling-model'

SSH_HOST='your-demo-server.example'
SSH_PORT='22'
SSH_USER='ubuntu'
# Raw multiline PEM, not a filename or base64. No passphrase for this demo.
SSH_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
replace-with-your-demo-key
-----END OPENSSH PRIVATE KEY-----'
# Leave empty to use ~/.ssh/known_hosts; provision verified host keys first.
SSH_KNOWN_HOSTS_FILE=''
# 'true' skips host key verification (no MITM protection). Demo servers only.
SSH_INSECURE_SKIP_HOST_KEY='false'
SRE_SLACK_USER_IDS='U0123456789,U9876543210'
# Exact names of existing containers on SSH_HOST (see deploy/compose.demo.yaml).
DOCKER_ALLOWED_CONTAINERS='demo-app,demo-api,demo-worker'
